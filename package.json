{
  "name": "@chronoai/nyx-assistant-sdk",
  "version": "0.2.0-alpha.3",
  "description": "NyxID client SDK for exposing a host application's context and tools to an authorized service",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nyx-chat": {
      "types": "./dist/nyx-chat.d.ts",
      "import": "./dist/nyx-chat.js"
    },
    "./voice": {
      "types": "./dist/voice.d.ts",
      "import": "./dist/voice.js"
    },
    "./agent-key": {
      "types": "./dist/widget-auth.d.ts",
      "import": "./dist/widget-auth.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js"
    }
  },
  "files": [
    "dist",
    "browser/nyx-widget.js"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-widget.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepare": "npm run build",
    "example:web": "npm run build && node examples/web/serve.mjs",
    "example:macos": "npm run build && swift -swift-version 5 examples/macos/Window.swift"
  },
  "dependencies": {
    "dompurify": "3.5.0",
    "eventsource-parser": "3.0.6",
    "idb-keyval": "6.3.0",
    "marked": "18.3.0",
    "marked-cjk-friendly": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.27.2",
    "fake-indexeddb": "6.2.8",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChronoAIProject/nyx-assistant-sdk.git"
  }
}
